configfile: "config/config.yaml"


include: "rules/common.smk"
include: "rules/references.smk"
include: "rules/starsolo.smk"
include: "rules/te_tools.smk"
include: "rules/anndata.smk"


rule all:
    input:
        expand(f"{OUT}/anndata/{{tool}}/{{sample}}.h5ad", tool=TOOLS, sample=SAMPLES.index),
        expand(f"{OUT}/anndata/{{tool}}_all_samples.h5ad", tool=TOOLS),
        f"{OUT}/qc/starsolo_summary.csv",


onsuccess:
    if all(os.path.exists(f) for f in expand(f"{OUT}/anndata/{{tool}}_all_samples.h5ad", tool=TOOLS)):
        print(f"\nDone! Your AnnData files are in {OUT}/anndata/\n")


onerror:
    print(f"\nSomething failed. Look at the newest file in {OUT}/logs/ for the error.\n")
